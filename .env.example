# ---------------------------------------------------------------------------
# Example configuration for agentrouter-codex-proxy.
# Copy to .env and edit as needed. (.env is gitignored; never commit real keys.)
#
#   Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# Upstream gateway base URL
AGENTROUTER_UPSTREAM=https://agentrouter.org

# Fallback API key used only when incoming requests lack an Authorization header.
# Usually Codex sends CODEX_GATEWAY_API_KEY from your user environment automatically.
# CODEX_GATEWAY_API_KEY=your-key-here

# Local loopback listen port (host is fixed to 127.0.0.1)
PROXY_PORT=8788

# Transport / fallback retry timings
PROXY_RETRY_DELAY_MS=300
PROXY_CONNECT_TIMEOUT_S=20.0
PROXY_READ_TIMEOUT_S=600.0

# Pre-commit SSE priming & rate-limit recovery
PROXY_RATE_LIMIT_BASE_S=2.0
PROXY_RATE_LIMIT_MAX_DELAY_S=15.0
PROXY_MAX_RATE_LIMIT_WAIT_S=45.0
PROXY_MAX_TRANSIENT_RETRIES=6
PROXY_RECOVERY_STAGGER_S=0.6
PROXY_SSE_PRIME_FIRST_TIMEOUT_S=45.0
PROXY_SSE_PRIME_CREATED_GRACE_S=3.0

# Image cap per request (keeps payload safely under OpenAI's 50-image limit)
PROXY_MAX_IMAGES=35

# Logging verbosity (1=info/warnings, 0=minimal)
PROXY_VERBOSE=1
